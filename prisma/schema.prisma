generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

model Product {
  id              BigInt      @id @default(autoincrement())
  name            String      @db.Text
  category        String      @db.Text
  in_stock        Boolean     @default(true)
  is_archived     Boolean     @default(false)
  archived_at     DateTime?   @db.Timestamptz(6)
  is_new          Boolean     @default(false)
  is_featured     Boolean     @default(false)
  sort_priority   Int         @default(0)
  min_order_qty   Int         @default(1)
  allowed_volumes String[]    @default([])
  order_items     OrderItem[]
  favorite_products FavoriteProduct[]
  saved_template_items SavedOrderTemplateItem[]
  announcement_links Announcement[]

  @@map("products")
  @@schema("public")
}

model Announcement {
  id                String    @id @default(uuid()) @db.Uuid
  title             String    @db.Text
  body              String    @db.Text
  variant           String    @default("info") @db.Text
  starts_at         DateTime  @default(now()) @db.Timestamptz(6)
  ends_at           DateTime? @db.Timestamptz(6)
  target_category   String?   @db.Text
  target_product_id BigInt?
  dismissible       Boolean   @default(true)
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
  target_product    Product?  @relation(fields: [target_product_id], references: [id], onDelete: SetNull)

  @@index([is_active, starts_at, ends_at], map: "announcements_active_window_idx")
  @@map("announcements")
  @@schema("public")
}

model Order {
  id                    String             @id @default(uuid()) @db.Uuid
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @default(now()) @db.Timestamptz(6)
  user_id               String?            @db.Uuid
  customer_name         String             @db.Text
  customer_email        String             @db.Text
  customer_phone        String?            @db.Text
  customer_company      String?            @db.Text
  customer_company_id   String?            @db.Text
  customer_vat_id       String?            @db.Text
  billing_address       String?            @db.Text
  billing_city          String?            @db.Text
  billing_postal_code   String?            @db.Text
  billing_country       String?            @db.Text
  shipping_company      String?            @db.Text
  shipping_contact_name String?            @db.Text
  shipping_address      String?            @db.Text
  shipping_city         String?            @db.Text
  shipping_postal_code  String?            @db.Text
  shipping_country      String?            @db.Text
  delivery_instructions String?            @db.Text
  total_volume          Decimal            @db.Decimal
  status                String             @default("pending") @db.Text
  note                  String?            @db.Text
  order_items           OrderItem[]
  internal_note         OrderInternalNote?
  user                  User?              @relation(fields: [user_id], references: [id], map: "orders_user_id_fkey")

  @@map("orders")
  @@schema("public")
}

// Administrativní poznámka je oddělená od zákaznické objednávky, aby ji klientská
// část aplikace nikdy nenačítala spolu s vlastní historií objednávek.
model OrderInternalNote {
  order_id   String   @id @db.Uuid
  note       String   @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_internal_notes")
  @@schema("public")
}

model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  order_id   String  @db.Uuid
  product_id BigInt
  quantity   Int
  volume     String  @db.Text
  order      Order   @relation(fields: [order_id], references: [id], map: "order_items_order_id_fkey")
  product    Product @relation(fields: [product_id], references: [id], map: "order_items_product_id_fkey")

  @@map("order_items")
  @@schema("public")
}

model Profile {
  id                       String   @id @db.Uuid
  email                    String?  @unique @db.Text
  full_name                String?  @db.Text
  company                  String?  @db.Text
  phone                    String?  @db.Text
  address                  String?  @db.Text
  city                     String?  @db.Text
  postal_code              String?  @db.Text
  company_id               String?  @db.Text
  vat_id                   String?  @db.Text
  billing_address          String?  @db.Text
  billing_city             String?  @db.Text
  billing_postal_code      String?  @db.Text
  billing_country          String?  @default("Česká republika") @db.Text
  shipping_same_as_billing Boolean  @default(true)
  shipping_company         String?  @db.Text
  shipping_contact_name    String?  @db.Text
  shipping_address         String?  @db.Text
  shipping_city            String?  @db.Text
  shipping_postal_code     String?  @db.Text
  shipping_country         String?  @default("Česká republika") @db.Text
  delivery_instructions    String?  @db.Text
  show_ordering_help       Boolean  @default(true)
  is_admin                 Boolean  @default(false)
  admin_registration_notification_status     String    @default("pending") @db.Text
  admin_registration_notification_attempts   Int       @default(0)
  admin_registration_notification_claimed_at DateTime? @db.Timestamptz(6)
  admin_registration_notified_at              DateTime? @db.Timestamptz(6)
  admin_registration_notification_error       String?   @db.Text
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @default(now()) @db.Timestamptz(6)

  @@map("profiles")
  @@schema("public")
}

model FavoriteProduct {
  user_id    String   @db.Uuid
  product_id BigInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([user_id, product_id])
  @@map("favorite_products")
  @@schema("public")
}

model SavedOrderTemplate {
  id         String                   @id @default(uuid()) @db.Uuid
  user_id    String                   @db.Uuid
  name       String                   @db.Text
  created_at DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at DateTime                 @default(now()) @db.Timestamptz(6)
  user       User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      SavedOrderTemplateItem[]

  @@unique([id, user_id])
  @@map("saved_order_templates")
  @@schema("public")
}

model SavedOrderTemplateItem {
  id          String             @id @default(uuid()) @db.Uuid
  template_id String             @db.Uuid
  user_id     String             @db.Uuid
  product_id  BigInt
  volume      String             @db.Text
  quantity    Int
  created_at  DateTime           @default(now()) @db.Timestamptz(6)
  template    SavedOrderTemplate @relation(fields: [template_id, user_id], references: [id, user_id], onDelete: Cascade)
  user        User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([template_id, product_id, volume])
  @@map("saved_order_template_items")
  @@schema("public")
}

model CustomerCart {
  user_id    String   @id @db.Uuid
  items      Json     @default("{}")
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("customer_carts")
  @@schema("public")
}

model AnalyticsEvent {
  id          BigInt   @id @default(autoincrement())
  event_name  String   @db.Text
  actor_key   String   @db.Text
  session_id  String   @db.Uuid
  journey_id  String   @db.Uuid
  device_type String   @default("unknown") @db.Text
  source      String?  @db.Text
  item_count  Int?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "analytics_events_created_at_idx")
  @@index([event_name, created_at(sort: Desc)], map: "analytics_events_event_created_idx")
  @@index([actor_key, created_at(sort: Desc)], map: "analytics_events_actor_created_idx")
  @@index([journey_id, created_at], map: "analytics_events_journey_created_idx")
  @@map("analytics_events")
  @@schema("public")
}

model User {
  id                   String                   @id @db.Uuid
  orders               Order[]
  favorite_products    FavoriteProduct[]
  saved_order_templates SavedOrderTemplate[]
  saved_template_items SavedOrderTemplateItem[]
  customer_cart        CustomerCart?

  @@map("users")
  @@schema("auth")
}
