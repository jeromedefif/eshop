{
  "name": "my-eshop-new",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run lint:ci && npm run test && NODE_OPTIONS=\"--max_old_space_size=4096\" next build --webpack",
    "start": "next start",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "lint": "eslint app --no-cache",
    "typecheck": "tsc --noEmit --incremental false",
    "lint:ci": "eslint app --no-cache",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.460.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-toastify": "^11.0.5",
    "resend": "6.28.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "postcss": "^8",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
